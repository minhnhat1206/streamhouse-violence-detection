# FastAPI Chatbot - LangGraph Agentic RAG
FROM python:3.10-slim

WORKDIR /app

# 1. System dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Python dependencies
COPY docker/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 3. Copy application code
COPY scripts/chatbot/ /app/scripts/chatbot/
COPY config/ /app/config/

# Set Python path - chatbot dir first so "from config import settings" resolves correctly
ENV PYTHONPATH=/app/scripts/chatbot:/app:$PYTHONPATH
ENV PYTHONUNBUFFERED=1

# Configuration
ENV API_PORT=5002
ENV DEBUG=False
ENV LOG_FORMAT=json

# Expose port
EXPOSE 5002

# Health check
HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:5002/health || exit 1

# Start FastAPI app with uvicorn
CMD ["uvicorn", "scripts.chatbot.main:app", \
     "--host", "0.0.0.0", \
     "--port", "5002", \
     "--log-level", "info"]