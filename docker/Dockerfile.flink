# Sử dụng image chuẩn của Flink 1.18 (tương thích hệ sinh thái Streamhouse)
FROM flink:1.18.1-scala_2.12

# Cài đặt Python 3.10 và các công cụ cần thiết cho PyFlink
RUN apt-get update -y && \
    apt-get install -y python3 python3-pip python3-dev wget && \
    rm -rf /var/lib/apt/lists/*

# Liên kết lệnh `python` tới `python3` để Flink tự nhận diện
RUN ln -s /usr/bin/python3 /usr/bin/python

# Cài đặt thư viện PyFlink (bắt buộc phải khớp với phiên bản Flink image)
RUN pip3 install apache-flink==1.18.1

# Tải Kafka Connector cho Flink 1.18 — đặt vào /opt/flink/lib/ (system classpath)
# để tránh classloading conflict khi chạy đồng thời với Fluss connector
RUN wget -q -O /opt/flink/lib/flink-sql-connector-kafka-3.1.0-1.18.jar \
    https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.1.0-1.18/flink-sql-connector-kafka-3.1.0-1.18.jar

# Tải Apache Fluss Connector cho Flink 1.18
RUN wget -q -O /opt/flink/lib/fluss-flink-1.18-0.9.0-incubating.jar \
    https://repo1.maven.org/maven2/org/apache/fluss/fluss-flink-1.18/0.9.0-incubating/fluss-flink-1.18-0.9.0-incubating.jar

# Tải Apache Fluss Tiering JAR cho Flink 1.18 (true Streamhouse write-once)
RUN wget -q -O /opt/flink/lib/fluss-flink-tiering-1.18-0.9.0-incubating.jar \
    https://archive.apache.org/dist/incubator/fluss/0.9.0-incubating/fluss-flink-tiering-1.18-0.9.0-incubating.jar || \
    echo "WARNING: Tiering JAR not available — fallback to sink_to_paimon_star.py"

# Tải Apache Paimon Connector cho Flink 1.18 (Warm Storage)
RUN wget -q -O /opt/flink/lib/paimon-flink-1.18-0.8.2.jar \
    https://repo1.maven.org/maven2/org/apache/paimon/paimon-flink-1.18/0.8.2/paimon-flink-1.18-0.8.2.jar

# Tải Paimon S3 filesystem plugin (cần thiết cho MinIO/S3 warehouse)
RUN wget -q -O /opt/flink/lib/paimon-s3-0.8.2.jar \
    https://repo1.maven.org/maven2/org/apache/paimon/paimon-s3/0.8.2/paimon-s3-0.8.2.jar

# Tải Hadoop dependency (cần thiết cho Paimon S3/HDFS config)
RUN wget -q -O /opt/flink/lib/flink-shaded-hadoop-2-uber-2.8.3-10.0.jar \
    https://repo.maven.apache.org/maven2/org/apache/flink/flink-shaded-hadoop-2-uber/2.8.3-10.0/flink-shaded-hadoop-2-uber-2.8.3-10.0.jar

# Tải Apache Iceberg Flink Runtime cho Flink 1.18 (Cold Storage)
RUN wget -q -O /opt/flink/lib/iceberg-flink-runtime-1.18-1.5.2.jar \
    https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-flink-runtime-1.18/1.5.2/iceberg-flink-runtime-1.18-1.5.2.jar

# Tải Flink SQL Connector Hive (fat jar — chứa HiveConf, Thrift, fb303 cho Iceberg HiveCatalog)
RUN wget -q -O /opt/flink/lib/flink-sql-connector-hive-3.1.3_2.12-1.18.1.jar \
    https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-hive-3.1.3_2.12/1.18.1/flink-sql-connector-hive-3.1.3_2.12-1.18.1.jar

# Tải Iceberg AWS Bundle (chứa AWS SDK v2 cho S3FileIO — cần thiết cho MinIO)
RUN wget -q -O /opt/flink/lib/iceberg-aws-bundle-1.5.2.jar \
    https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws-bundle/1.5.2/iceberg-aws-bundle-1.5.2.jar
