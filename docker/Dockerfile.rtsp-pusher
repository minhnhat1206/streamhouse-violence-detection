FROM python:3.10-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY scripts/streaming/rtsp_pusher.py /app/rtsp_pusher.py

# No extra Python deps — only stdlib + ffmpeg binary
CMD ["python", "/app/rtsp_pusher.py"]