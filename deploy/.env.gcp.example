# =========================
# GCP VM — Environment Variables
# Instance: instance-20260524-104630, Zone: asia-southeast1-b
# =========================
# COPY this file to .env.gcp and fill in real values (never commit .env.gcp)
# Usage: docker compose -f docker-compose.gcp.yml --env-file .env.gcp up -d

# =========================
# GCP VM Public IP (bắt buộc)
# =========================
GCP_VM_EXTERNAL_IP=136.110.16.108

# =========================
# AI & Chatbot
# =========================
GEMINI_API_KEY=your_gemini_api_key_here

# =========================
# Storage (MinIO)
# =========================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=mypassword
MINIO_SECURE=false

# =========================
# Database (MySQL Metastore)
# =========================
METASTORE_DB_USER=root
METASTORE_DB_PASSWORD=root
METASTORE_DB_NAME=metastore

# =========================
# Kafka
# =========================
KAFKA_BROKER=kafka:9092

# =========================
# Monitoring (optional — profile monitoring)
# =========================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
