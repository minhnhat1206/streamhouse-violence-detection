# =============================================================================
# Cloud Environment Variables — Streamhouse Violence Detection
# Copy this file to .env.cloud and fill in actual values
# NEVER commit .env.cloud to git
# =============================================================================

# ─── Domain ──────────────────────────────────────────────────────────────────
DOMAIN_NAME=yourdomain.com
API_DOMAIN=api.yourdomain.com
GRAFANA_DOMAIN=grafana.yourdomain.com
MINIO_DOMAIN=minio.yourdomain.com

# ─── AI & Chatbot ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Storage (MinIO) ─────────────────────────────────────────────────────────
# CHANGE THESE FROM DEFAULTS before deploying
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_32CHARS
MINIO_SECURE=false

# ─── Database (MySQL Hive Metastore) ─────────────────────────────────────────
# CHANGE THESE FROM DEFAULTS before deploying
METASTORE_DB_USER=hive_user
METASTORE_DB_PASSWORD=CHANGE_THIS_DB_PASSWORD
METASTORE_DB_NAME=metastore

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKER=kafka:9092

# ─── Trino ───────────────────────────────────────────────────────────────────
TRINO_HOST=trino-coordinator
TRINO_PORT=8080

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/app/chroma_db

# ─── Flink ───────────────────────────────────────────────────────────────────
FLINK_S3_ENDPOINT=http://minio:9000
FLINK_S3_ACCESS_KEY=minio_admin
FLINK_S3_SECRET_KEY=CHANGE_THIS_STRONG_PASSWORD_32CHARS

# ─── Oracle Cloud specific ───────────────────────────────────────────────────
# Your Oracle VM public IP (for Kafka external access by inference server)
ORACLE_VM_PUBLIC_IP=your.oracle.vm.ip

# ─── VioMoViNet (Inference Server) ───────────────────────────────────────────
# IP of the machine running VioMoViNet (local GPU machine or RunPod)
# Used to configure firewall rules — only this IP can reach Kafka port 9092
INFERENCE_SERVER_IP=your.inference.server.ip

# ─── Frontend (Vercel) ───────────────────────────────────────────────────────
# These are used when building the frontend for production
VITE_API_BASE=https://api.yourdomain.com
VITE_GRAFANA_URL=https://grafana.yourdomain.com
VITE_MINIO_BASE=https://minio.yourdomain.com

# ─── Grafana ─────────────────────────────────────────────────────────────────
# Change from default admin/admin
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# ─── Nginx basic auth (for internal dashboards) ──────────────────────────────
# Generate with: htpasswd -nb admin yourpassword
NGINX_BASIC_AUTH_CREDENTIALS=admin:$apr1$xxxxxxxxxxxxx
