# =============================================================================
# VioMoViNet → Oracle Cloud Kafka Bridge Config
# Copy this to the machine running VioMoViNet inference
# Usage: docker run --env-file kafka-bridge.env viomovinet:latest
# =============================================================================

# Kafka on Oracle Cloud (replace with your Oracle VM public IP)
KAFKA_BOOTSTRAP_SERVERS=YOUR_ORACLE_VM_IP:9092
KAFKA_TOPIC_OUTPUT=urban-safety-alerts
KAFKA_TOPIC_DLQ=urban-safety-alerts-dlq

# MinIO on Oracle Cloud (for storing evidence frames)
MINIO_ENDPOINT=YOUR_ORACLE_VM_IP:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=CHANGE_THIS_STRONG_PASSWORD_32CHARS
MINIO_BUCKET=evidence-frames
MINIO_SECURE=false

# Redis (if VioMoViNet needs local Redis cache — run locally)
REDIS_HOST=localhost
REDIS_PORT=6379

# Inference settings
HIGH_SERVER_PORT=8001
LOW_MED_SERVER_PORT=8002
INFERENCE_FPS=10              # Process 10 frames/sec (not all frames)
VIOLENCE_THRESHOLD=0.5        # Score above this → send alert
FRAME_SAVE_THRESHOLD=0.3      # Score above this → save frame to MinIO

# Camera streams (RTSP sources)
# Add your actual camera URLs here
RTSP_STREAMS=rtsp://cam1:554/stream,rtsp://cam2:554/stream
